# Copy this file to .env for local development:  cp .env.example .env
# On Railway these are set in the service Variables tab instead (DATABASE_URL is
# injected automatically by the PostgreSQL plugin).

# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-dev-only-change-me-in-production

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgres://app:app@localhost:5432/app
