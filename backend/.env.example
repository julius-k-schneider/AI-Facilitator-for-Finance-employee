# Copy this file to .env for local development:  cp .env.example .env
# Also copy the repository-root .env.example to .env for shared n8n secrets.
# On Railway these are set in the service Variables tab instead (DATABASE_URL is
# injected automatically by the PostgreSQL plugin).

# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-dev-only-change-me-in-production

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgres://app:app@localhost:5432/app

# Server-side interactive agent/chat access. Mission generation is routed through
# n8n below. Never expose these values in the frontend.
KICONNECT_API_KEY=
KICONNECT_BASE_URL=https://chat.kiconnect.nrw/api/v1
KICONNECT_MODEL=OpenAI GPT OSS 120b KI:Inferenz.nrw
# Change this only if the Uni API uses a different OpenAI-compatible path.
KICONNECT_CHAT_COMPLETIONS_PATH=/chat/completions

# n8n mission-generation orchestration. Compose overrides the URL with the same
# internal service URL. Shared service/encryption secrets live in the gitignored
# repository-root .env and are injected into both containers by Compose.
N8N_MISSION_GENERATION_URL=http://n8n:5678/webhook/mission-generation
N8N_REQUEST_TIMEOUT=10
N8N_WORKFLOW_VERSION=v1
MISSION_TASK_DAYS_PER_WEEK=2

# Email reminders for newly published missions.
# Local DEBUG defaults to console email output unless EMAIL_BACKEND is overridden.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.me.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AI Facilitator <deine-mail@gmail.com>
