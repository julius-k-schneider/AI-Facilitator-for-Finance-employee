# Copy this file to .env in the repository root. Docker Compose reads it
# automatically. Use three different random values and never commit the real file.
N8N_SERVICE_SECRET=change-me-to-a-long-random-service-secret
N8N_CALLBACK_SECRET=change-me-to-a-different-long-random-callback-secret
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-n8n-encryption-key
